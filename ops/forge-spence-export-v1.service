[Unit]
Description=Publish the version 1 Forge-to-Spence data projection
After=local-fs.target
ConditionPathExists=/var/lib/forge/forge.db
ConditionPathIsDirectory=/var/lib/forge/exports

[Service]
Type=oneshot
User=forge-web
Group=forge-web
UMask=0027
ExecStart=/usr/local/libexec/forge-spence-export-v1

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/forge
ReadOnlyPaths=/var/lib/forge/forge.db
ReadOnlyPaths=-/var/lib/forge/forge.db-wal
InaccessiblePaths=/var/lib/spence /srv/secrets
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
