[Unit]
Description=Publish the version 1 Forge-to-Spence data projection
After=local-fs.target
ConditionPathExists=/var/lib/forge/forge.db
ConditionPathIsDirectory=/var/lib/forge/exports

[Service]
Type=oneshot
User=forge
Group=forge
UMask=0027
# FORGE owns the publisher (ops/spence-export-v1.php in each FORGE release): it converts FORGE's
# UTC timestamps to local wall time. pcre.jit=0 because of MemoryDenyWriteExecute below;
# LD_LIBRARY_PATH works around this host's PHP CLI sqlite loader conflict.
Environment=LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu
ExecStart=/usr/bin/php -d pcre.jit=0 /usr/local/lib/forge/current/ops/spence-export-v1.php

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/forge
ReadOnlyPaths=/var/lib/forge/forge.db
ReadOnlyPaths=-/var/lib/forge/forge.db-wal
InaccessiblePaths=/var/lib/spence
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
