# Example AppArmor hat for the dedicated Spence PHP-FPM pool (apparmor_hat = spence),
# included from the php-fpm parent profile. Paths follow the example layout in
# DEPLOYMENT.md; adjust them to yours.
profile spence {
  include <abstractions/php-worker>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  /opt/spence/ r,
  /opt/spence/** r,

  /etc/spence/access-key r,
  /etc/spence/nanogpt-key r,
  /etc/spence/tenants/ r,
  /etc/spence/tenants/*.key r,
  /etc/spence/tenants/*.nanogpt r,

  /run/php/spence-fpm.sock rw,
  @{PROC}/@{pid}/attr/{apparmor/,}current r,

  /var/lib/spence/ r,
  /var/lib/spence/spence.db rwk,
  /var/lib/spence/spence.db-{journal,wal,shm} rwk,
  /var/lib/spence/uploads/ rw,
  /var/lib/spence/uploads/** rwk,
  /var/lib/spence/tmp/ rw,
  /var/lib/spence/tmp/** rwk,
  /var/lib/spence/sessions/ rw,
  /var/lib/spence/sessions/sess_* rwk,

  # Guest tenants (ops/spence-create-tenant.php): one database and uploads tree each.
  /var/lib/spence/tenants/ r,
  /var/lib/spence/tenants/*/ r,
  /var/lib/spence/tenants/*/spence.db rwk,
  /var/lib/spence/tenants/*/spence.db-{journal,wal,shm} rwk,
  /var/lib/spence/tenants/*/uploads/ rw,
  /var/lib/spence/tenants/*/uploads/** rwk,

  /var/lib/forge/ r,
  /var/lib/forge/exports/ r,
  /var/lib/forge/exports/spence-v1.db r,

  # Required for DNS and NanoGPT HTTPS. AppArmor cannot restrict a socket by
  # DNS name; the host firewall and application URL remain the network bounds.
  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,

  # Optional recipe-to-shopping-list handoff (SPENCE_INGREDIENTS_PATH): the one
  # file only, with no access to the other app's code or directory creation.
  /srv/ingredients/ r,
  /srv/ingredients/shopping_list.json rw,
}
